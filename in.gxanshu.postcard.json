{
  "id": "in.gxanshu.postcard",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.golang"
  ],
  "command": "postcard",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--filesystem=xdg-config/autostart:create",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.gnome.OnlineAccounts",
    "--talk-name=org.gnome.Settings",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "blueprint-compiler",
      "buildsystem": "meson",
      "cleanup": [
        "*"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/jwestman/blueprint-compiler",
          "tag": "v0.20.4",
          "commit": "cb333fb74a6cb0bd7506f05c222e8e057fa0a2e9"
        }
      ]
    },
    {
      "name": "sqlcipher3",
      "buildsystem": "simple",
      "build-commands": [
        "python3 -m pip install --prefix=/app --no-deps --no-build-isolation ."
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://files.pythonhosted.org/packages/ce/8a/284f2daec79883151172f3f2f3e35505c90dc48feb081602b4f5c35331d1/sqlcipher3-0.6.4.tar.gz",
          "sha256": "b02a3edfc554c9197d63ab4c38a30f7682eec65b10e5be2c9285a0d6ffb7a29a"
        }
      ]
    },
    {
      "name": "postcard-tuta",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/postcard-tuta/cargo",
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "build-commands": [
        "cargo build --offline --locked --release",
        "install -Dm755 target/release/postcard-tuta /app/bin/postcard-tuta"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "native/tuta",
          "skip": [
            "target",
            "upstream/target",
            "upstream/tuta-repo"
          ]
        },
        "native/tuta/cargo-sources.json"
      ]
    },
    {
      "name": "postcard-proton",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/golang/bin",
        "env": {
          "GOFLAGS": "-mod=vendor",
          "GOPATH": "/run/build/postcard-proton/gopath",
          "GOCACHE": "/run/build/postcard-proton/gocache",
          "GOPROXY": "off"
        }
      },
      "build-commands": [
        "go build -o postcard-proton .",
        "install -Dm755 postcard-proton /app/bin/postcard-proton"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "native/proton"
        }
      ]
    },
    {
      "name": "postcard",
      "builddir": true,
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": ".",
          "skip": [
            "build",
            ".flatpak",
            ".flatpak-builder",
            ".git",
            "postcard-*.flatpak",
            "native/tuta/target",
            "native/tuta/upstream/tuta-repo"
          ]
        }
      ],
      "config-opts": [
        "--libdir=lib"
      ]
    }
  ]
}
